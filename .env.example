# RaapNexus Enterprise Environment Configuration

# Production Application Base URL
NEXT_PUBLIC_APP_URL=https://raapnexus.com

# Optional CRM / Lead Delivery Webhook
DEMO_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
CRM_API_KEY=your_secure_crm_api_key_here

# MCP Server Gateway Connection (Optional for live enterprise pilot)
MCP_GATEWAY_URL=https://mcp.raapnexus.internal/v1
MCP_SECRET_KEY=your_mcp_hmac_secret_key

# Node Environment
NODE_ENV=production
